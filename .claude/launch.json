{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "cloudflare-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--config", "wrangler-worker.toml", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "mcp-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["mcp-server/index.js"],
      "port": 3100
    }
  ]
}
