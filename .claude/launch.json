{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-frontend",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["node_modules/.bin/vite", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "cloudflare-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--config", "wrangler-worker.toml", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "mcp-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["mcp-server/index.js"],
      "port": 3100
    }
  ]
}
